FLASK_SECRET_KEY=your_secret_key_here
# DeepSeek（會議記錄整理 / 工作包拆分 / 廣告月報）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 選填，預設 https://api.deepseek.com 與 deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Groq（音檔轉中文逐字稿，選填；一般由前端「API 設定」填入）
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3

# Colab 備援預設停用。僅設定由公司控制的 HTTPS origin（不含路徑）。
# 使用者輸入必須與此位址相同；ngrok 位址更新後需重新設定並部署。
COLAB_API_URL=

# 公司登入：預設 disabled（公開存取）；選 google 或 microsoft 後缺少設定會拒絕服務。
AUTH_MODE=disabled
AUTH_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google Workspace：明列允許的 hosted domains，以逗號分隔，不支援萬用字元。
AUTH_GOOGLE_DOMAINS=
# Microsoft：單一 tenant UUID，且使用者須獲指派此應用程式角色。
AUTH_MICROSOFT_TENANT_ID=
AUTH_MICROSOFT_ROLE=MarketAI.User

# 專案與文件保存：先啟用公司登入，再設定 PostgreSQL URL 並執行 flask --app app library-init。
# 請在部署平台的私密環境變數設定，不要提交含密碼的連線字串。
DATABASE_URL=
# 本機可使用 sqlite:////絕對路徑/marketai.sqlite3；Vercel 明確拒絕 SQLite。
